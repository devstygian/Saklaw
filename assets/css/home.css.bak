/* styles.css - Barangay Digital Citizen Portal */
/* Desktop-first responsive layout, modern gov style */

:root{
  --primary:#1E40AF;   /* royal blue */
  --accent:#22274d;    /* golden yellow */
  --bg:#F3F4F6;
  --muted:#6B7280;
  --text:#0F172A;
  --card:#ffffff;
  --radius:14px;
  --maxw:1100px;
  --gap:20px;
  font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.45;
  font-size:16px;
}

/* make room for fixed header so content isn't hidden behind it */
main{padding-top:72px}

/* page wrap */
.wrap{
  max-width:var(--maxw);
  margin:0 auto;
  padding:5px;
}

/* header */
.site-header{
  background:var(--primary);
  color:#fff;
  padding:10px 0;
  box-shadow:0 6px 18px rgba(14, 30, 70, 0.12);
  position:fixed;
  top:0;
  left:0;
  right:0;
  width:100%;
  z-index:999;
  font-size: 18px;

}
.header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.logo{display:flex;align-items:center;gap:12px}
.logo img{width:56px;height:56px;border-radius:6px;object-fit:cover}
.logo-text strong{display:block;font-size:18px;letter-spacing:0.6px}
.logo-text .sub{font-size:12px;opacity:0.95}

/* nav */
.main-nav a{
  color:rgba(255,255,255,0.95);
  text-decoration:none;
  margin-left:18px;
  font-weight:600;
}
